{
  "name": "vite-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:build": "pnpm --filter @packages/web build",
    "web:serve": "pnpm --filter @packages/web start",
    "stanza:serve": "pnpm --filter @packages/stanza stanza:server",
    "stanza:build": "pnpm --filter @packages/stanza stanza:build",
    "storybook:serve": "pnpm stanza:storybook:serve",
    "lint": "oxlint -c oxlint.config.ts . --quiet",
    "lint:debug": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts . --fix --quiet",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "fmt": "pnpm run format",
    "fmt:check": "pnpm run format:check",
    "test": "vitest run && pnpm --filter @packages/sparql test",
    "test:watch": "vitest run --watch",
    "type-check": "oxlint -c oxlint.config.ts . --type-aware --type-check",
    "check-all": "pnpm run format && pnpm run lint && pnpm run type-check && pnpm run test",
    "stanza:storybook:serve": "pnpm --filter @packages/stanza storybook",
    "stanza:storybook:build": "pnpm --filter @packages/stanza build-storybook"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "copy-anything": "^4.1.0",
    "is-what": "^5.5.0",
    "jotai": "^3.0.0",
    "nanoid": "^6.0.1",
    "pluralize": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-types/shared": "^3.36.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "consola": "^3.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.28",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
