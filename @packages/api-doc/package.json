{
  "name": "@packages/doc",
  "version": "0.1.0",
  "private": true,
  "description": "This package is deprecated. Please use @packages/api instead.",
  "type": "module",
  "scripts": {
    "tsp:clean": "run-func scripts/clean.js clean",
    "tsp:build": "npm run tsp:clean && tsp compile src/main.tsp",
    "tsp:copy-to-web": "run-func scripts/bundle.js bundle",
    "dsp:dev": "npm run tsp:clean && tsp compile src/main.tsp --watch",
    "vite": "vite",
    "vite:build": "vite build",
    "format": "tsp format '**/*.tsp'",
    "dev": "concurrently \"npm run dsp:dev\" \"npm run vite\"",
    "bundle": "npm run tsp:build && npm run vite:build && npm run tsp:copy-to-web"
  },
  "devDependencies": {
    "@typespec/compiler": "1.16.0",
    "@typespec/http": "1.16.0",
    "@typespec/json-schema": "1.16.0",
    "@typespec/openapi": "1.16.0",
    "@typespec/openapi3": "1.16.0",
    "@typespec/prettier-plugin-typespec": "1.16.0",
    "@typespec/rest": "0.86.0",
    "@typespec/versioning": "0.86.0",
    "concurrently": "^10.0.5"
  },
  "deprecated": true
}
